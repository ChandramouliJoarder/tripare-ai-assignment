    {
      "name": "16. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 or 503', function () {",
              "  pm.expect([200, 503]).to.include(pm.response.code);",
              "});",
              "var data = pm.response.json();",
              "pm.test('Has status field', function () { pm.expect(data.status).to.exist; });",
              "pm.test('Has suppliers.supplierA', function () { pm.expect(data.suppliers.supplierA).to.exist; });",
              "pm.test('Has suppliers.supplierB', function () { pm.expect(data.suppliers.supplierB).to.exist; });",
              "pm.test('Has redis', function () { pm.expect(data.redis).to.exist; });",
              "pm.test('Has temporal', function () { pm.expect(data.temporal).to.exist; });",
              "pm.test('Has checkedAt ISO string', function () {",
              "  pm.expect(new Date(data.checkedAt).toISOString()).to.eql(data.checkedAt);",
              "});"
            ]
          }
        }
