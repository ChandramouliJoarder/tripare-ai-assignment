{
  "info": {
    "name": "Hotel Offer Orchestrator",
    "description": "Complete test collection for the Hotel Offer Orchestrator API. Run requests top-to-bottom with the Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Delhi — Best Prices",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city=delhi",
          "host": ["{{baseUrl}}"],
          "path": ["api", "hotels"],
          "query": [{ "key": "city", "value": "delhi" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response is array', function () { pm.expect(pm.response.json()).to.be.an('array'); });",
              "var data = pm.response.json();",
              "pm.test('No duplicate hotel names', function () {",
              "  var names = data.map(h => h.name.trim().toLowerCase().replace(/\\\\s+/g,' '));",
              "  var unique = [...new Set(names)];",
              "  pm.expect(names.length).to.eql(unique.length);",
              "});",
              "pm.test('Holtin is 5340 from Supplier B', function () {",
              "  var holtin = data.find(h => h.name === 'Holtin');",
              "  pm.expect(holtin).to.exist;",
              "  pm.expect(holtin.price).to.eql(5340);",
              "  pm.expect(holtin.supplier).to.eql('Supplier B');",
              "});",
              "pm.test('Radison is 5900 from Supplier A', function () {",
              "  var r = data.find(h => h.name === 'Radison');",
              "  pm.expect(r).to.exist;",
              "  pm.expect(r.price).to.eql(5900);",
              "  pm.expect(r.supplier).to.eql('Supplier A');",
              "});",
              "pm.test('Sorted ascending by price', function () {",
              "  for (var i = 1; i < data.length; i++) {",
              "    pm.expect(data[i].price).to.be.at.least(data[i-1].price);",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Delhi — Price Range 4000-6000",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=4000&maxPrice=6000",
          "host": ["{{baseUrl}}"],
          "path": ["api", "hotels"],
          "query": [
            { "key": "city", "value": "delhi" },
            { "key": "minPrice", "value": "4000" },
            { "key": "maxPrice", "value": "6000" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "var data = pm.response.json();",
              "pm.test('All prices in range 4000-6000', function () {",
              "  data.forEach(function(h) {",
              "    pm.expect(h.price).to.be.at.least(4000);",
              "    pm.expect(h.price).to.be.at.most(6000);",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
