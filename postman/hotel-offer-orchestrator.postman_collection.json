            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('X-Partial-Result header is true', function () {",
              "  pm.expect(pm.response.headers.get('X-Partial-Result')).to.eql('true');",
              "});",
              "pm.test('X-Failed-Suppliers contains supplierB', function () {",
              "  pm.expect(pm.response.headers.get('X-Failed-Suppliers')).to.include('supplierB');",
              "});",
              "var data = pm.response.json();",
              "pm.test('All hotels from Supplier A', function () {",
              "  data.forEach(function(h) { pm.expect(h.supplier).to.eql('Supplier A'); });",
              "});"
